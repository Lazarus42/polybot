[Unit]
Description=Polymarket paper market-making simulator (live, virtual orders -> S3 snapshots)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=ec2-user
WorkingDirectory=/home/ec2-user/polymarket_exp
Environment=PYTHONUNBUFFERED=1
# Streams the live CLOB book, runs the SAME Quoter as the backtest (no drift), and lands
# per-minute virtual-quote/fill/reward snapshots (gzip, rotated 15 min) for the S3 uploader.
# Quotes the reward-eligible tokens from the latest manifest the collector wrote. Places NO real
# orders. --minutes huge so it runs forever under systemd; restart on crash.
ExecStart=/home/ec2-user/polymarket_exp/.venv/bin/python scripts/paper_sim.py \
    --live --configs neutral neutral_ctl predict_skew predict_skew_ctl \
      take_profit_3c take_profit_3c_ctl take_profit_5c \
      longshot longshot_thin tail_favorite \
      longshot_thin_shortdated longshot_thin_norewards longshot_thin_expolitics \
      longshot_thin_tp15 longshot_thin_tp30 longshot_thin_2x longshot_thin_5x \
      longshot_5_7_thin longshot_thin_5k \
      fav_hold fav_politics fav_far fav_politics_far \
      predict_skew_gencat take_profit_3c_gencat neutral_gencat \
    --size 0 --capital 5000 --inv-cap-mult 5 --fill-model prorata --max-capture-share 0.10 \
    --min-roc 0.0 --max-roc 0.10 --cull-loss 3.0 --cull-cooldown 12 \
    --quote-latency 0.2 --cancel-on-move 0.01 --max-hold-minutes 120 \
    --manifest-dir /home/ec2-user/polymarket_exp/reports/clob_capture \
    --minutes 1000000000 --rotate-minutes 15 --refresh-minutes 5 \
    --output-dir /home/ec2-user/polymarket_exp/reports/paper_sim
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
